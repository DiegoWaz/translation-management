# ─────────────────────────────────────────────────────────────
# Configuration équipe — seul fichier à personnaliser
# ─────────────────────────────────────────────────────────────
# Installation :
#   cp .env.example .env
#   # renseigner les valeurs ci-dessous
#   pnpm install && pnpm run dev
#
# .env est gitignored — ne jamais committer de token.
# ─────────────────────────────────────────────────────────────

VITE_GH_TOKEN=
VITE_GH_OWNER=
VITE_GH_REPO=
VITE_GH_BRANCH=main
VITE_GH_BASE_LANG=fr-FR
VITE_GH_PATH_TEMPLATE=locales/{lang}.json
VITE_GH_CONFIG_PATH_TEMPLATE=configs/{lang}.json
VITE_GH_CONFIG_SCHEMA_PATH=configs/schema.json
# Locales actives (source de vérité équipe) — séparées par des virgules
VITE_GH_LANGS=en-UK,fr-FR
